#!/usr/bin/env python3
"""Stand-in specimux: every read goes to full/ITS/S1.fastq, every other one also to S2.
Reads gzipped input as the real one does."""
import gzip, sys
from pathlib import Path
args = sys.argv[1:]
out = Path(args[args.index("-O") + 1]); fastq = Path(args[2])
pool = out / "full" / "ITS"; pool.mkdir(parents=True, exist_ok=True)
lines = (gzip.open(fastq, "rt") if fastq.name.endswith(".gz") else open(fastq)).read().splitlines()
reads = [lines[i:i + 4] for i in range(0, len(lines), 4)]
with open(pool / "S1.fastq", "a") as f1, open(pool / "S2.fastq", "a") as f2:
    for i, r in enumerate(reads):
        f1.write("\n".join(r) + "\n")
        if i % 2:
            f2.write("\n".join(r) + "\n")
